def int_check(question, low=None, exit_code=None):

    while True:

        response = input(question).lower()

        # Check for exit code
        if response == exit_code:
            return response

        try:
            response = int(response)

            # Check number is high enough
            if response < low:
                print(f"Please enter a number that is {low} or more.")

            else:
                return response

        except ValueError:
            print("Please enter a whole number or 'xxx' to quit.")


# Main routine starts here

num_questions = int_check(
    "How many questions? ",
    low=1,
    exit_code="xxx"
)

# Check if user chose to quit
if num_questions == "xxx":
    print("Program exited.")

else:
    print(f"You chose {num_questions} questions.")
