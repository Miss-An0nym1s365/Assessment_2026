def int_check(question, low=None, exit_code=None):

    while True:

        response = input(question).lower()

        # Infinite mode
        if response == "":
            return ""

        # Exit program
        if response == exit_code:
            return exit_code

        try:
            response = int(response)

            # Check number is high enough
            if response < low:
                print(f"Please enter a number that is {low} or more.")

            else:
                return response

        except ValueError:
            print("Please enter a whole number, press Enter for infinite mode, or type 'xxx' to quit.")


# Main routine starts here

num_questions = int_check(
    "How many questions? <Press Enter for infinite mode>: ",
    low=1,
    exit_code="xxx"
)

# Check for infinite mode
if num_questions == "":
    mode = "infinite"
    print("Infinite mode selected.")

# Check for quit
elif num_questions == "xxx":
    print("Program exited.")

# Normal mode
else:
    mode = "normal"
    print(f"You chose {num_questions} questions.")
